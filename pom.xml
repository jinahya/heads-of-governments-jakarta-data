<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Modelled on mysql-sakila-jakarta-data, which is Jakarta Data over mysql-sakila-persistence's entities; this one is
    over heads-of-governments-persistence's. Unlike that one, it has jinahya-parent as its parent and the unified
    version, as every submodule of jakarta-persistence-applied-book-projects does.
    -->
  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-parent</artifactId>
    <version>1.1.1</version>
  </parent>

  <groupId>io.github.jinahya</groupId>
  <artifactId>heads-of-governments-jakarta-data</artifactId>
  <version>0.6.10-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>Jakarta Data for the heads-of-governments database</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Upstream (heads-of-governments-persistence) compiles its main sources at release 17 and its tests at 25; 17 is
      therefore the floor for anything compiled against its entities. Both halves here are 25.
      -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <!--
      Keep parameter names in the class files. Jakarta Data binds a query method's parameters by their names
      (`@By`-less `findByCountry(String country)`, `:country` in @Query) and the processor reads them from source, but a
      consumer compiling against this jar sees them only if they are kept.
      -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!--
      Quarkus runs the tests: it bootstraps Hibernate ORM, injects the repositories hibernate-processor generates, and
      manages, through its BOM, every jakarta.* API (jakarta.data-api 1.0.1, jakarta.persistence-api 3.2) and JUnit.
      https://quarkus.io/guides/hibernate-orm
      https://central.sonatype.com/artifact/io.quarkus.platform/quarkus-bom/versions
      -->
    <version.io.quarkus.platform>3.40.1.1</version.io.quarkus.platform>
    <!--
      Hibernate ORM, hibernate-processor too, at the baseline of PROJECTS_VERSIONS.asciidoc, which upstream builds
      on too, over the one Quarkus's BOM manages (7.4.9.Final); see the direct entries below. Only the artifacts this
      module uses are pinned, not hibernate-platform, which would also take, e.g., Jandex below what Quarkus needs.
      https://central.sonatype.com/artifact/org.hibernate.orm/hibernate-platform/versions
      -->
    <version.org.hibernate.orm>7.4.13.Final</version.org.hibernate.orm>

    <!-- The sibling, at the unified version: `./mvnw -DskipTests install` it to pick up a change there. -->
    <version.heads-of-governments-persistence>0.6.10-SNAPSHOT</version.heads-of-governments-persistence>

    <!-- The versions below are upstream's, where it names the same. -->
    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>
    <!-- https://central.sonatype.com/artifact/org.xerial/sqlite-jdbc/versions -->
    <version.org.xerial.sqlite-jdbc>3.53.4.0</version.org.xerial.sqlite-jdbc>
    <!-- https://central.sonatype.com/artifact/org.assertj/assertj-core/versions -->
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <!-- https://central.sonatype.com/artifact/org.slf4j/slf4j-api/versions -->
    <version.org.slf4j>2.0.20</version.org.slf4j>
    <!-- https://central.sonatype.com/artifact/org.jspecify/jspecify/versions -->
    <version.org.jspecify>1.0.1</version.org.jspecify>

    <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-surefire-plugin/versions -->
    <version.maven-surefire>3.6.0</version.maven-surefire>
    <version.maven-failsafe>${version.maven-surefire}</version.maven-failsafe>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- A direct entry below beats an imported one. -->
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.io.quarkus.platform}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Hibernate ORM at the baseline, over Quarkus's; see version.org.hibernate.orm. -->
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-processor</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-community-dialects</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>
      <!-- quarkus-hibernate-orm's, kept with hibernate-core. -->
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-graalvm</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-jcache</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>

      <!-- At the baseline, over Quarkus's. -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${version.org.slf4j}</version>
      </dependency>

      <!-- The upstream entity jar. -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>heads-of-governments-persistence</artifactId>
        <version>${version.heads-of-governments-persistence}</version>
      </dependency>

      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${version.org.jspecify}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${version.org.projectlombok}</version>
      </dependency>

      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${version.org.assertj}</version>
      </dependency>

      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${version.org.xerial.sqlite-jdbc}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      main =======================================================================================
      The entities, and their static metamodel, that the repositories are for. Upstream's jakarta.* dependencies are
      provided there, so none arrive transitively.
      -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>heads-of-governments-persistence</artifactId>
      <scope>compile</scope>
    </dependency>
    <!--
      The API the repositories are written in. Provided: a consumer brings its own Jakarta Data, Jakarta Persistence
      and provider. jakarta.persistence-api is declared since main code may use JPA types itself.
      -->
    <dependency>
      <groupId>jakarta.data</groupId>
      <artifactId>jakarta.data-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Bean Validation constraints on repository method parameters (@NotBlank, @Positive, ...). The API only, provided:
      enforcing them takes a provider, which the application brings.
      -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      hibernate-processor emits each repository implementation as a CDI bean, @Dependent with an @Inject constructor,
      when it sees these on the classpath; without them, a plain class whose constructor takes the StatelessSession.
      Provided, so that the generated classes are injectable under a container and the annotations cost a consumer
      without one nothing.
      -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      The generated implementations are written against org.hibernate.StatelessSession, so hibernate-core is a compile
      dependency of this jar, provided: the consumer runs them on its own Hibernate.
      -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- @NullMarked on the package; CLASS-retained, so a consumer needs it only to read the nullness. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Main and test sources alike; a compile-time tool only, so neither packaged nor passed on. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      test frameworks ============================================================================
      Quarkus, with Hibernate ORM, for @QuarkusTest: it starts the persistence unit application.properties configures,
      and injects the generated repositories, which open their StatelessSession from it.
      -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      test runtime ===============================================================================
      The driver of src/test/resources/heads_of_governments.sqlite3, a copy of upstream's, and Hibernate's
      SQLiteDialect. Test scope, so consumers get neither.
      -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.maven-surefire}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${version.maven-failsafe}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Two processors on the processor path of both executions, default-compile and default-testCompile: Lombok, and
        hibernate-processor, which implements every @Repository interface of the main sources as a <Name>_ class
        under target/generated-sources/annotations. Each <path> takes its version from dependencyManagement
        (annotationProcessorPathsUseDepMgmt), so the processor and the hibernate-core it generates against stay in
        step. The processor needs the entities on the classpath to resolve a repository's entity type; the upstream
        jar is a compile dependency, so they are.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>org.hibernate.orm</groupId>
              <artifactId>hibernate-processor</artifactId>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xlint</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!-- Dependency convergence and the Maven version come from jinahya-parent; the JDK and the profiles from here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <!-- The build JDK: the compiler release above is 25. -->
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- A -P naming a profile that does not exist is silently ignored by Maven; this makes it a failure. -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The log manager Quarkus logs through, set before anything touches java.util.logging. -->
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Binds maven-failsafe-plugin, which runs the *IT classes. -->
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
